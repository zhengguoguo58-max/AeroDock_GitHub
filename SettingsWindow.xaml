<Window x:Class="GlassDock.SettingsWindow"
        Title="AeroDock"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="880"
        Height="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Icon="Assets\app.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        Loaded="SettingsWindow_Loaded">

    <!-- ============================================================ -->
    <!-- AeroDock 设置中心 · 深色卡片版                                  -->
    <!-- 左侧窄导航（外观 / 行为），右侧内容区用 Visibility 切换          -->
    <!-- 控件名称、ValueChanged / Checked 事件、JSON 读写全部保持原样    -->
    <!-- ============================================================ -->

    <Window.Resources>

        <!-- 深色主题色板 -->

        <SolidColorBrush x:Key="WindowBgBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="NavBgBrush" Color="#18181B"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#2D2D30"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#3A3A42"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F7"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#858594"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7C6CFF"/>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <LinearGradientBrush x:Key="AccentGradientBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#4DA3FF" Offset="0"/>
            <GradientStop Color="#A855F7" Offset="1"/>
        </LinearGradientBrush>

        <!-- 卡片：圆角 + 细描边 + 柔和投影 -->

        <Style x:Key="NeoCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16"
                                      ShadowDepth="3"
                                      Direction="270"
                                      Opacity="0.28"
                                      Color="#000000"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#4A4A56"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 卡片里的深色胶囊按钮：选择壁纸 / 清除壁纸共用 -->

        <Style x:Key="NeoActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#2A2A31"/>
            <Setter Property="Foreground" Value="#F2F2F7"/>
            <Setter Property="BorderBrush" Value="#3F3F49"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#35353F"/>
                                <Setter Property="BorderBrush" Value="#5A5A6A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#24242B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 极简滑块：极细渐变轨道 + 小圆点 + 悬停发光 -->
        <!-- 只替换外观模板，不动任何 ValueChanged 绑定 -->

        <Style x:Key="GlassSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">

                            <!-- 未填充轨道 -->

                            <Border Height="3"
                                    CornerRadius="1.5"
                                    Background="#34343C"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False"/>

                            <Track x:Name="PART_Track"
                                   Orientation="Horizontal">

                                <!-- 已填充轨道：赛博蓝 → 紫渐变 -->

                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent">
                                                    <Border Height="3"
                                                            CornerRadius="1.5"
                                                            Background="{StaticResource AccentGradientBrush}"
                                                            VerticalAlignment="Center"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>

                                <!-- 小圆点滑块：悬停 / 拖动时出现紫色光晕 -->

                                <Track.Thumb>
                                    <Thumb Width="22"
                                           Height="22"
                                           Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Ellipse x:Name="KnobGlow"
                                                             Fill="#668B5CF6"
                                                             Opacity="0">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect BlurRadius="16"
                                                                              ShadowDepth="0"
                                                                              Color="#8B5CF6"
                                                                              Opacity="0.95"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                    <Ellipse x:Name="KnobRing"
                                                             Width="18"
                                                             Height="18"
                                                             Fill="#1E1E1E"
                                                             Stroke="#6C6C7A"
                                                             StrokeThickness="1"/>
                                                    <Ellipse x:Name="KnobCore"
                                                             Width="10"
                                                             Height="10"
                                                             Fill="#E9E9F2"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="KnobGlow" Property="Opacity" Value="1"/>
                                                        <Setter TargetName="KnobRing" Property="Stroke" Value="#A78BFA"/>
                                                        <Setter TargetName="KnobCore" Property="Fill" Value="#FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="KnobGlow" Property="Opacity" Value="1"/>
                                                        <Setter TargetName="KnobRing" Property="Stroke" Value="#A78BFA"/>
                                                        <Setter TargetName="KnobCore" Property="Fill" Value="#FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>

                            </Track>

                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 深色胶囊开关：保留原有 Checked / Unchecked 事件 -->

        <Style x:Key="GlassToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Border x:Name="SwitchTrack"
                                    CornerRadius="12"
                                    Background="#34343C"
                                    BorderThickness="1"
                                    BorderBrush="#45454F"/>
                            <Ellipse x:Name="SwitchKnob"
                                     Width="18"
                                     Height="18"
                                     Margin="3,0,0,0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Fill="#C8C8D2"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#7C6CFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#6D5AF5"/>
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#9B87FF"/>
                                <Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="SwitchKnob" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="SwitchKnob" Property="Fill" Value="#FFFFFFFF"/>
                                <Setter TargetName="SwitchKnob" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="10"
                                                          ShadowDepth="0"
                                                          Color="#8B5CF6"
                                                          Opacity="0.9"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 深色分段药丸：桌面图标处理模式二选一 -->

        <Style x:Key="GlassRadioPillStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#B8B8C6"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PillTrack"
                                CornerRadius="9"
                                Background="#2A2A31"
                                BorderThickness="1"
                                BorderBrush="#3A3A44">
                            <ContentPresenter Margin="10,0,10,0"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Content"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillTrack" Property="BorderBrush" Value="#5A5A68"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillTrack" Property="Background" Value="#302A4F"/>
                                <Setter TargetName="PillTrack" Property="BorderBrush" Value="#8B5CF6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 深色下拉框：材质预设三选一 -->
        <!-- 只替换外观模板，选中项 / SelectionChanged 逻辑保持标准 ComboBox 行为 -->

        <Style x:Key="NeoComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#2A2A31"/>
            <Setter Property="Foreground" Value="#F2F2F7"/>
            <Setter Property="BorderBrush" Value="#3F3F49"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="PresetToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="PresetChrome"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                CornerRadius="9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>

                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="12,0,0,0"
                                                                  VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  TextBlock.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  TextBlock.FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>

                                                <Path Grid.Column="1"
                                                      Data="M 0 0 L 4 4 L 8 0"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                      StrokeThickness="1.5"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="PresetChrome" Property="BorderBrush" Value="#5A5A6A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   StaysOpen="False"
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="#232329"
                                        BorderBrush="#3F3F49"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="4">
                                    <ScrollViewer x:Name="PART_ScrollViewer"
                                                  MaxHeight="210"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#F2F2F7"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="PresetItemBg"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="7"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="PresetItemBg" Property="Background" Value="#3A3A44"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="PresetItemBg" Property="Background" Value="#4C4470"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 左侧导航项：选中时点亮渐变指示条 -->

        <Style x:Key="NeoSideNavStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="#A0A0AE"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="NavBackground"
                                    CornerRadius="11"
                                    Background="Transparent"/>
                            <Border x:Name="AccentBar"
                                    Width="3"
                                    Height="22"
                                    CornerRadius="1.5"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource AccentGradientBrush}"
                                    Opacity="0"/>
                            <ContentPresenter Margin="20,0,12,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              ContentSource="Content"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBackground" Property="Background" Value="#23232A"/>
                                <Setter Property="Foreground" Value="#D8D8E2"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBackground" Property="Background" Value="#28242F"/>
                                <Setter TargetName="AccentBar" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- 窗口外壳：纯深色底 + 圆角 + 外投影（不再使用液态玻璃） -->

    <Border x:Name="SettingsShell"
            Margin="26"
            CornerRadius="18"
            Background="{StaticResource WindowBgBrush}"
            BorderThickness="1"
            BorderBrush="#2E2E36">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30"
                              ShadowDepth="8"
                              Direction="270"
                              Opacity="0.45"
                              Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ==================================================== -->
            <!-- 左侧：窄导航栏                                        -->
            <!-- ==================================================== -->

            <Border Grid.Column="0"
                    Background="{StaticResource NavBgBrush}"
                    CornerRadius="17,0,0,17"
                    BorderThickness="0,0,1,0"
                    BorderBrush="#2A2A31">
                <Grid Margin="16,22,16,18">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 品牌区 -->

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="6,0,0,30">
                        <Border Width="36"
                                Height="36"
                                CornerRadius="11"
                                Background="{StaticResource AccentGradientBrush}">
                            <TextBlock Text="A"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="AeroDock"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#F6F6FA"/>
                            <TextBlock Text="SETTINGS"
                                       FontSize="9"
                                       FontFamily="Consolas"
                                       Foreground="#777784"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 导航按钮：点击后切换右侧面板 -->

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="设置"
                                   FontSize="10"
                                   Foreground="#6F6F7C"
                                   Margin="10,0,0,10"/>

                        <RadioButton x:Name="NavAppearance"
                                     GroupName="SettingsNavGroup"
                                     IsChecked="True"
                                     Style="{StaticResource NeoSideNavStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◐"
                                           FontSize="15"
                                           FontFamily="Segoe UI Symbol"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="外观"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavBehavior"
                                     GroupName="SettingsNavGroup"
                                     Style="{StaticResource NeoSideNavStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="☰"
                                           FontSize="14"
                                           FontFamily="Segoe UI Symbol"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="行为"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- 底部提示 -->

                    <Border Grid.Row="3"
                            Background="#202027"
                            CornerRadius="12"
                            BorderThickness="1"
                            BorderBrush="#303039"
                            Padding="12,11">
                        <StackPanel>
                            <TextBlock Text="即时生效"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#C9C9D4"/>
                            <TextBlock Text="所有设置自动保存到本地&#x0a;重启后依然保留"
                                       FontSize="10"
                                       Foreground="#777784"
                                       LineHeight="16"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>

            <!-- ==================================================== -->
            <!-- 右侧：内容区                                          -->
            <!-- ==================================================== -->

            <Grid Grid.Column="1"
                  Margin="26,20,24,20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 标题栏：按住可拖动窗口 -->

                <Grid Grid.Row="0"
                      Height="62"
                      Background="Transparent"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown">

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="设置中心"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Foreground="#F7F7FB"/>
                        <TextBlock Text="个性化你的 AeroDock 体验"
                                   FontSize="11.5"
                                   Foreground="#858594"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <Border x:Name="CloseButton"
                            Width="32"
                            Height="32"
                            CornerRadius="16"
                            Cursor="Hand"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,4,0,0"
                            RenderTransformOrigin="0.5,0.5"
                            MouseLeftButtonDown="CloseButton_MouseDown"
                            MouseLeftButtonUp="CloseButton_Click"
                            MouseEnter="CloseButton_MouseEnter"
                            MouseLeave="CloseButton_MouseLeave">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#26262D"/>
                                <Setter Property="BorderBrush" Value="#3A3A44"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#3A2430"/>
                                        <Setter Property="BorderBrush" Value="#B05A6E"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="CloseButtonScale"
                                            ScaleX="1"
                                            ScaleY="1"/>
                        </Border.RenderTransform>

                        <TextBlock Text="&#x2715;"
                                   FontSize="12"
                                   Foreground="#F0FFFFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Border>

                </Grid>

                <!-- 标题栏底部分隔线 -->

                <Border Grid.Row="0"
                        Height="1"
                        Background="#2B2B33"
                        VerticalAlignment="Bottom"/>

                <ScrollViewer Grid.Row="1"
                              Margin="0,14,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>

                        <!-- ============================ -->
                        <!-- 外观面板                      -->
                        <!-- ============================ -->

                        <Grid x:Name="AppearancePanel"
                              Visibility="{Binding IsChecked, ElementName=NavAppearance, Converter={StaticResource BoolToVisibility}}">

                            <StackPanel>

                                <!-- 面板标题 -->

                                <StackPanel Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="4"
                                                Height="20"
                                                CornerRadius="2"
                                                Background="{StaticResource AccentGradientBrush}"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Text="外观"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F4F4F8"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="分别调整 Dock 与展板的材质，以及壁纸取色"
                                               FontSize="11.5"
                                               Foreground="#858594"
                                               Margin="14,6,0,0"/>
                                </StackPanel>

                                <!-- 卡片 0：材质预设 -->

                                <Border Style="{StaticResource NeoCardStyle}"
                                        Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    Margin="0,0,16,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="材质预设"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#F1F1F6"/>
                                            <TextBlock Text="一键切换 Dock 的整体材质风格，修改立即生效并自动保存"
                                                       FontSize="11"
                                                       Foreground="#858594"
                                                       Margin="0,4,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <ComboBox x:Name="MaterialPresetCombo"
                                                  Grid.Column="1"
                                                  Width="210"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource NeoComboBoxStyle}"
                                                  SelectionChanged="MaterialPresetCombo_SelectionChanged">
                                            <ComboBoxItem Content="经典亚克力 (Acrylic)" Tag="0"/>
                                            <ComboBoxItem Content="极简纯色 (Minimal)" Tag="1"/>
                                            <ComboBoxItem Content="高光质感 (Glossy)" Tag="2"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <!-- 卡片 1：背景透明度 -->

                                <Border Style="{StaticResource NeoCardStyle}"
                                        Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0"
                                                    Grid.Column="0">
                                            <TextBlock Text="背景透明度"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#F1F1F6"/>
                                            <TextBlock Text="控制 Dock 玻璃面板的通透程度"
                                                       FontSize="11"
                                                       Foreground="#858594"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Row="0"
                                                Grid.Column="1"
                                                Background="#232329"
                                                CornerRadius="7"
                                                Padding="9,4"
                                                VerticalAlignment="Top">
                                            <TextBlock x:Name="OpacityText"
                                                       Text="1.00"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#9B8CFF"/>
                                        </Border>

                                        <Slider x:Name="OpacitySlider"
                                                Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                Margin="0,14,0,0"
                                                Minimum="0.1"
                                                Maximum="1.0"
                                                Value="1.0"
                                                SmallChange="0.05"
                                                LargeChange="0.1"
                                                IsMoveToPointEnabled="True"
                                                Style="{StaticResource GlassSliderStyle}"
                                                ValueChanged="OpacitySlider_ValueChanged"/>

                                    </Grid>
                                </Border>

                                <!-- 卡片 2：背景模糊度 -->

                                <Border Style="{StaticResource NeoCardStyle}"
                                        Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0"
                                                    Grid.Column="0">
                                            <TextBlock Text="背景模糊度"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#F1F1F6"/>
                                            <TextBlock Text="调节背景虚化强度，数值越高越柔和"
                                                       FontSize="11"
                                                       Foreground="#858594"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Row="0"
                                                Grid.Column="1"
                                                Background="#232329"
                                                CornerRadius="7"
                                                Padding="9,4"
                                                VerticalAlignment="Top">
                                            <TextBlock x:Name="BlurText"
                                                       Text="0"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#9B8CFF"/>
                                        </Border>

                                        <Slider x:Name="BlurSlider"
                                                Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                Margin="0,14,0,0"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="0"
                                                SmallChange="1"
                                                LargeChange="10"
                                                IsMoveToPointEnabled="True"
                                                Style="{StaticResource GlassSliderStyle}"
                                                ValueChanged="BlurSlider_ValueChanged"/>

                                    </Grid>
                                </Border>

                                <!-- 卡片 3：展板透明度 -->

                                <Border Style="{StaticResource NeoCardStyle}"
                                        Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0"
                                                    Grid.Column="0">
                                            <TextBlock Text="展板透明度"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#F1F1F6"/>
                                            <TextBlock Text="独立控制大展板玻璃的通透程度，不影响 Dock"
                                                       FontSize="11"
                                                       Foreground="#858594"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Row="0"
                                                Grid.Column="1"
                                                Background="#232329"
                                                CornerRadius="7"
                                                Padding="9,4"
                                                VerticalAlignment="Top">
                                            <TextBlock x:Name="LaunchBoardOpacityText"
                                                       Text="0.80"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#9B8CFF"/>
                                        </Border>

                                        <Slider x:Name="LaunchBoardOpacitySlider"
                                                Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                Margin="0,14,0,0"
                                                Minimum="0.1"
                                                Maximum="1.0"
                                                Value="0.8"
                                                SmallChange="0.05"
                                                LargeChange="0.1"
                                                IsMoveToPointEnabled="True"
                                                Style="{StaticResource GlassSliderStyle}"
                                                ValueChanged="LaunchBoardOpacitySlider_ValueChanged"/>

                                    </Grid>
                                </Border>

                                <!-- 卡片 4：展板模糊度 -->

                                <Border Style="{StaticResource NeoCardStyle}"
                                        Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0"
                                                    Grid.Column="0">
                                            <TextBlock Text="展板模糊度"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#F1F1F6"/>
                                            <TextBlock Text="调节大展板玻璃的磨砂强度，不影响 Dock"
                                                       FontSize="11"
                                                       Foreground="#858594"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Row="0"
                                                Grid.Column="1"
                                                Background="#232329"
                                                CornerRadius="7"
                                                Padding="9,4"
                                                VerticalAlignment="Top">
                                            <TextBlock x:Name="LaunchBoardBlurText"
                                                       Text="30"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#9B8CFF"/>
                                        </Border>

                                        <Slider x:Name="LaunchBoardBlurSlider"
                                                Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                Margin="0,14,0,0"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="30"
                                                SmallChange="1"
                                                LargeChange="10"
                                                IsMoveToPointEnabled="True"
                                                Style="{StaticResource GlassSliderStyle}"
                                                ValueChanged="LaunchBoardBlurSlider_ValueChanged"/>

                                    </Grid>
                                </Border>

                                <!-- 卡片 5：展板自定义壁纸 -->
                                <Border Style="{StaticResource NeoCardStyle}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock Text="展板背景壁纸" FontSize="13" FontWeight="SemiBold" Foreground="#F1F1F6"/>
                                            <TextBlock Text="铺在展板玻璃之上、图标与文字之下，不影响原有材质和图标"
                                                       FontSize="11" Foreground="#858594" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button x:Name="LaunchBoardWallpaperChooseButton"
                                                    Content="选择展板壁纸"
                                                    Style="{StaticResource NeoActionButtonStyle}"
                                                    Click="LaunchBoardWallpaperChooseButton_Click"
                                                    ToolTip="支持 jpg / jpeg / png / bmp / gif / webp / tif 等格式"/>
                                            <Button x:Name="LaunchBoardWallpaperClearButton"
                                                    Content="清除壁纸" Margin="8,0,0,0" IsEnabled="False"
                                                    Style="{StaticResource NeoActionButtonStyle}"
                                                    Click="LaunchBoardWallpaperClearButton_Click"
                                                    ToolTip="清除后恢复展板原来的毛玻璃 / Acrylic 材质"/>
                                        </StackPanel>

                                        <TextBlock x:Name="LaunchBoardWallpaperPathText"
                                                   Grid.Row="1" Grid.ColumnSpan="2"
                                                   Text="未选择壁纸" FontSize="10.5" Foreground="#6F6F7C"
                                                   Margin="0,12,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>

                                        <!-- 裁剪预览：取景框固定 300x216.67，与展板 900:650 同比例 -->
                                        <!-- 在这里拖动平移 / 滚轮缩放，主界面展板会同步变化 -->

                                        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,14,0,0">
                                            <Border x:Name="LaunchBoardWallpaperPreviewBorder"
                                                    Width="300"
                                                    Height="216.67"
                                                    HorizontalAlignment="Left"
                                                    Background="#141418"
                                                    BorderBrush="#3F3F49"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    ClipToBounds="True">
                                                <!-- WPF 的 Border 只裁背景不裁子元素， -->
                                                <!-- 这里补一个圆角裁切，预览图不会盖住四个圆角 -->
                                                <Border.Clip>
                                                    <RectangleGeometry Rect="0,0,300,216.67"
                                                                       RadiusX="10"
                                                                       RadiusY="10"/>
                                                </Border.Clip>
                                                <Grid x:Name="LaunchBoardWallpaperPreviewHost"
                                                      Background="Transparent"
                                                      ClipToBounds="True"
                                                      Cursor="SizeAll"
                                                      MouseLeftButtonDown="LaunchBoardWallpaperPreview_MouseLeftButtonDown"
                                                      MouseMove="LaunchBoardWallpaperPreview_MouseMove"
                                                      MouseLeftButtonUp="LaunchBoardWallpaperPreview_MouseLeftButtonUp"
                                                      LostMouseCapture="LaunchBoardWallpaperPreview_LostMouseCapture"
                                                      MouseWheel="LaunchBoardWallpaperPreview_MouseWheel">
                                                    <!-- 用 Rectangle + ImageBrush 而不是 Image：
                                                         通过 Viewbox 直接裁源图，
                                                         UniformToFill 丢掉的左右 / 上下区域才能被拖回来 -->
                                                    <Rectangle x:Name="LaunchBoardWallpaperPreviewSurface"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>

                                                    <TextBlock x:Name="LaunchBoardWallpaperPreviewEmptyText"
                                                               Text="选择壁纸后，可在此裁剪"
                                                               FontSize="11.5"
                                                               Foreground="#6F6F7C"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               IsHitTestVisible="False"/>

                                                    <Border x:Name="LaunchBoardWallpaperPreviewHintBorder"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom"
                                                            Margin="0,0,8,8"
                                                            Padding="7,4"
                                                            CornerRadius="6"
                                                            Background="#B0101014"
                                                            IsHitTestVisible="False"
                                                            Visibility="Collapsed">
                                                        <TextBlock x:Name="LaunchBoardWallpaperPreviewHintText"
                                                                   Text="拖动平移 · 滚轮缩放"
                                                                   FontSize="10"
                                                                   Foreground="#D8D8E2"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <TextBlock Grid.Row="3"
                                                   Grid.ColumnSpan="2"
                                                   Text="在预览框内按住左键拖动，滚轮缩放；主界面展板会实时同步"
                                                   FontSize="10.5"
                                                   Foreground="#6F6F7C"
                                                   Margin="0,8,0,0"
                                                   TextWrapping="Wrap"/>

                                        <Grid Grid.Row="4" Grid.ColumnSpan="2" Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="壁纸不透明度" FontSize="12" Foreground="#D8D8E2" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Background="#232329" CornerRadius="7" Padding="9,4">
                                                <TextBlock x:Name="LaunchBoardWallpaperOpacityText" Text="0.80"
                                                           FontSize="11" FontWeight="SemiBold" Foreground="#9B8CFF"/>
                                            </Border>
                                        </Grid>

                                        <Slider x:Name="LaunchBoardWallpaperOpacitySlider"
                                                Grid.Row="5" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                                Minimum="0" Maximum="1" Value="0.8"
                                                SmallChange="0.05" LargeChange="0.1"
                                                IsMoveToPointEnabled="True"
                                                Style="{StaticResource GlassSliderStyle}"
                                                ValueChanged="LaunchBoardWallpaperOpacitySlider_ValueChanged"/>
                                    </Grid>
                                </Border>


                                <!-- 卡片 6：壁纸取色 -->

                                <Border Style="{StaticResource NeoCardStyle}"
                                        Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0"
                                                    Grid.Column="0"
                                                    Margin="0,0,16,0">
                                            <TextBlock Text="壁纸取色"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#F1F1F6"/>
                                            <TextBlock Text="截取当前屏幕主色，让 Dock 与桌面氛围融合"
                                                       FontSize="11"
                                                       Foreground="#858594"
                                                       Margin="0,4,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <Grid Grid.Row="0"
                                              Grid.Column="1"
                                              Width="132"
                                              Height="38"
                                              VerticalAlignment="Top">

                                            <!-- 视觉层：只负责外观，不接收点击 -->

                                            <Border x:Name="TintButton"
                                                    Height="38"
                                                    CornerRadius="10"
                                                    Background="#2A2A31"
                                                    BorderThickness="1"
                                                    BorderBrush="#3F3F49"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="TintButtonScale"
                                                                    ScaleX="1"
                                                                    ScaleY="1"/>
                                                </Border.RenderTransform>

                                                <TextBlock x:Name="TintText"
                                                           Text="壁纸取色"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="#F2F2F7"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False"/>
                                            </Border>

                                            <!-- 点击层：真正的 Button，保证 Click 一定触发 -->

                                            <Button x:Name="TintClickButton"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Focusable="False"
                                                    Click="TintButton_Click"
                                                    MouseEnter="TintButton_MouseEnter"
                                                    MouseLeave="TintButton_MouseLeave"
                                                    ToolTip="截取当前屏幕提取主色并应用到 Dock 玻璃（壁纸文件失效也可用）">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>

                                        <StackPanel Grid.Row="1"
                                                    Grid.ColumnSpan="2"
                                                    Orientation="Horizontal"
                                                    Margin="0,16,0,0">
                                            <Ellipse Width="8"
                                                     Height="8"
                                                     Fill="#4DA3FF"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center"/>
                                            <Ellipse Width="8"
                                                     Height="8"
                                                     Fill="#8B5CF6"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center"/>
                                            <Ellipse Width="8"
                                                     Height="8"
                                                     Fill="#F472B6"
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="再次点击可关闭取色"
                                                       FontSize="10.5"
                                                       Foreground="#6F6F7C"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                    </Grid>
                                </Border>

                                <!-- 外观面板底部说明 -->

                                <StackPanel Orientation="Horizontal"
                                            Margin="4,4,0,0">
                                    <Ellipse Width="6"
                                             Height="6"
                                             Fill="#4ADE80"
                                             Margin="0,0,7,0"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="滑块数值会实时应用到 Dock 面板"
                                               FontSize="10.5"
                                               Foreground="#6F6F7C"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                            </StackPanel>
                        </Grid>

                        <!-- ============================ -->
                        <!-- 行为面板                      -->
                        <!-- ============================ -->

                        <Grid x:Name="BehaviorPanel"
                              Visibility="{Binding IsChecked, ElementName=NavBehavior, Converter={StaticResource BoolToVisibility}}">

                            <StackPanel>

                                <!-- 面板标题 -->

                                <StackPanel Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="4"
                                                Height="20"
                                                CornerRadius="2"
                                                Background="{StaticResource AccentGradientBrush}"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Text="行为"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F4F4F8"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="控制 Dock 的锁定、自启动与桌面图标行为"
                                               FontSize="11.5"
                                               Foreground="#858594"
                                               Margin="14,6,0,0"/>
                                </StackPanel>

                                <!-- 卡片 1：交互与启动 -->

                                <Border Style="{StaticResource NeoCardStyle}"
                                        Margin="0,0,0,12">
                                    <StackPanel>

                                        <!-- 锁定位置 -->

                                        <Grid MinHeight="52">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="34"
                                                    Height="34"
                                                    CornerRadius="9"
                                                    Background="#232329"
                                                    VerticalAlignment="Center">
                                                <Path Data="M8,10 L8,8 A4,4 0 0 1 16,8 L16,10 M6,10 L18,10 A1,1 0 0 1 19,11 L19,19 A1,1 0 0 1 18,20 L6,20 A1,1 0 0 1 5,19 L5,11 A1,1 0 0 1 6,10 Z"
                                                      Fill="Transparent"
                                                      Stroke="#9B8CFF"
                                                      StrokeThickness="1.5"
                                                      StrokeLineJoin="Round"
                                                      Width="16"
                                                      Height="18"
                                                      Stretch="Uniform"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"/>
                                            </Border>

                                            <StackPanel Grid.Column="1"
                                                        Margin="12,0,16,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="锁定位置"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#F1F1F6"/>
                                                <TextBlock Text="Dock 位置固定，不会因拖动而移动"
                                                           FontSize="11"
                                                           Foreground="#858594"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <CheckBox x:Name="LockToggle"
                                                      Grid.Column="2"
                                                      VerticalAlignment="Center"
                                                      Style="{StaticResource GlassToggleSwitchStyle}"
                                                      Checked="LockToggle_Changed"
                                                      Unchecked="LockToggle_Changed"/>
                                        </Grid>

                                        <Border Height="1"
                                                Background="#2B2B33"
                                                Margin="46,12,0,12"/>

                                        <!-- 开机自启动 -->

                                        <Grid MinHeight="52">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="34"
                                                    Height="34"
                                                    CornerRadius="9"
                                                    Background="#232329"
                                                    VerticalAlignment="Center">
                                                <Path Data="M12,3 A9,9 0 1 1 5.7,6 M12,3 L12,11 M12,3 L17,7"
                                                      Fill="Transparent"
                                                      Stroke="#4DA3FF"
                                                      StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Width="17"
                                                      Height="17"
                                                      Stretch="Uniform"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"/>
                                            </Border>

                                            <StackPanel Grid.Column="1"
                                                        Margin="12,0,16,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="开机自启动"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#F1F1F6"/>
                                                <TextBlock Text="登录系统后自动运行 GlassDock"
                                                           FontSize="11"
                                                           Foreground="#858594"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <CheckBox x:Name="StartupToggle"
                                                      Grid.Column="2"
                                                      VerticalAlignment="Center"
                                                      Style="{StaticResource GlassToggleSwitchStyle}"
                                                      Checked="StartupToggle_Changed"
                                                      Unchecked="StartupToggle_Changed"/>
                                        </Grid>

                                        <Border Height="1"
                                                Background="#2B2B33"
                                                Margin="46,12,0,12"/>

                                        <!-- 点击空白处关闭展板 -->

                                        <Grid MinHeight="52">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="34"
                                                    Height="34"
                                                    CornerRadius="9"
                                                    Background="#232329"
                                                    VerticalAlignment="Center">
                                                <Path Data="M5,3 L15,12 L10.5,12.6 L13,18 L10.8,19 L8.3,13.6 L5,16.8 Z"
                                                      Fill="Transparent"
                                                      Stroke="#4ADE80"
                                                      StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Width="17"
                                                      Height="17"
                                                      Stretch="Uniform"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"/>
                                            </Border>

                                            <StackPanel Grid.Column="1"
                                                        Margin="12,0,16,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="点击空白处关闭展板"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#F1F1F6"/>
                                                <TextBlock Text="展板打开时，点击展板外的空白区域自动关闭"
                                                           FontSize="11"
                                                           Foreground="#858594"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <CheckBox x:Name="CloseBoardOutsideToggle"
                                                      Grid.Column="2"
                                                      VerticalAlignment="Center"
                                                      Style="{StaticResource GlassToggleSwitchStyle}"
                                                      Checked="CloseBoardOutsideToggle_Changed"
                                                      Unchecked="CloseBoardOutsideToggle_Changed"/>
                                        </Grid>

                                    </StackPanel>
                                </Border>

                                <!-- 卡片 2：桌面图标处理模式 -->

                                <Border Style="{StaticResource NeoCardStyle}"
                                        Margin="0,0,0,12">
                                    <StackPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="34"
                                                    Height="34"
                                                    CornerRadius="9"
                                                    Background="#232329"
                                                    VerticalAlignment="Top">
                                                <Path Data="M3,5 A2,2 0 0 1 5,3 L10,3 A2,2 0 0 1 12,5 L12,12 A2,2 0 0 1 10,14 L5,14 A2,2 0 0 1 3,12 Z M8,8 A2,2 0 0 1 10,6 L16,6 A2,2 0 0 1 18,8 L18,15 A2,2 0 0 1 16,17 L10,17 A2,2 0 0 1 8,15 Z"
                                                      Fill="Transparent"
                                                      Stroke="#F472B6"
                                                      StrokeThickness="1.4"
                                                      StrokeLineJoin="Round"
                                                      Width="17"
                                                      Height="17"
                                                      Stretch="Uniform"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"/>
                                            </Border>

                                            <StackPanel Grid.Column="1"
                                                        Margin="12,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="桌面图标处理模式"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#F1F1F6"/>
                                                <TextBlock Text="选择桌面图标的显示方式，收纳后桌面更清爽"
                                                           FontSize="11"
                                                           Foreground="#858594"
                                                           Margin="0,3,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="46,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <RadioButton x:Name="IconModeKeepRadio"
                                                         Grid.Column="0"
                                                         GroupName="SettingsCenterIconModeGroup"
                                                         Content="保留在桌面"
                                                         Margin="0,0,5,0"
                                                         HorizontalAlignment="Stretch"
                                                         HorizontalContentAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Style="{StaticResource GlassRadioPillStyle}"
                                                         Checked="IconModeKeep_Checked"/>

                                            <RadioButton x:Name="IconModeStoreRadio"
                                                         Grid.Column="1"
                                                         GroupName="SettingsCenterIconModeGroup"
                                                         Content="收纳至 Dock"
                                                         Margin="5,0,0,0"
                                                         HorizontalAlignment="Stretch"
                                                         HorizontalContentAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Style="{StaticResource GlassRadioPillStyle}"
                                                         Checked="IconModeStore_Checked"/>
                                        </Grid>

                                    </StackPanel>
                                </Border>

                                <!-- 行为面板底部说明 -->

                                <StackPanel Orientation="Horizontal"
                                            Margin="4,4,0,0">
                                    <Ellipse Width="6"
                                             Height="6"
                                             Fill="#4ADE80"
                                             Margin="0,0,7,0"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="所有设置即时生效，并自动保存到本地，重启不会丢"
                                               FontSize="10.5"
                                               Foreground="#6F6F7C"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                            </StackPanel>
                        </Grid>

                    </Grid>
                </ScrollViewer>

            </Grid>

        </Grid>
    </Border>

</Window>

